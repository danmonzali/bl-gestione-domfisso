<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout charset="UTF-8" pattern="{${env:LOG_DEST},&quot;timestamp&quot;:%d{UNIX_MILLIS},&quot;livello&quot;:&quot;%-5level&quot;,&quot;sorgente&quot;:&quot;%X{gupSource}&quot;,&quot;destinazione&quot;:&quot;%X{gupDestination}&quot;,&quot;canale_di_provenienza&quot;:&quot;%X{gupSourceChannel}&quot;,&quot;id_univoco&quot;:&quot;%X{gupId}&quot;,&quot;componente_applicativa&quot;:&quot;%X{gupApplicationComponent}&quot;,&quot;servizio_applicativo&quot;:&quot;%logger{35}&quot;,&quot;tipo_Evento&quot;:&quot;%X{gupEventType}&quot;,&quot;tempo_di_esecuzione&quot;:%equals{%X{gupExeTime}}{}{0},&quot;Return_code_Evento&quot;:&quot;%X{gupEventReturnCode}&quot;,&quot;Evento&quot;:{&quot;TID&quot;:&quot;%X{gupTid}&quot;,&quot;call_system&quot;:&quot;%X{call_system}&quot;,&quot;call_operation&quot;:&quot;%X{call_operation}&quot;,&quot;call_result&quot;:&quot;%X{call_result}&quot;,&quot;descrizione&quot;:&quot;%replace{%replace{%replace{%msg}{\t}{}}{&quot;}{\\\&quot;}}{[\r\n]+}{}%replace{%replace{%replace{%throwable{separator(|)}}{\t}{}}{&quot;}{\\\&quot;}}{[\r\n]+}{}&quot;}}%throwable{none}%n" />
		</Console>
	</Appenders>
	<Loggers>
		<Logger name="it.tim"
			level="${env:LOG_LEVEL_SERVICE}"
			additivity="false">
			<AppenderRef ref="Console" />			
		</Logger>
		<Logger name="it.tim.bl.gestione.domfisso" level="${env:LOG_LEVEL_SERVICE}" additivity="false">
			<AppenderRef ref="Console" />
		</Logger>		
		<Logger name="tim.who.is" level="${env:LOG_LEVEL_SERVICE}" additivity="false">
			<AppenderRef ref="Console" />
		</Logger>
		<Root level="${env:LOG_LEVEL_ROOT}">
			<AppenderRef ref="Console" />
		</Root>
	</Loggers>
</Configuration>


